---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { absoluteUrl, buildDirectoryData, categoryPath, itemPath, SITE_URL } from '../utils/data';

const { categories, validSections, featuredItems, totalItems } = buildDirectoryData();
const sectionSummaries = validSections.map((group) => ({
  id: group.meta.id,
  icon: group.meta.icon,
  name: group.meta.name,
  fullName: group.meta.fullName,
  count: group.items.length,
}));
const categoryCountById = new Map(sectionSummaries.map((section) => [section.id, section.count]));
const initialSection = {
  id: 'featured',
  icon: '•',
  name: '每日推荐',
  fullName: '每日推荐',
  items: featuredItems,
};
const directoryPayload = JSON.stringify({
  sections: [
    initialSection,
    ...validSections.map((group) => ({
      id: group.meta.id,
      icon: group.meta.icon,
      name: group.meta.name,
      fullName: group.meta.fullName,
      keywords: group.meta.keywords || '',
      items: group.items,
    })),
  ],
}).replace(/</g, '\\u003c');

const pageDescription = `收录 ${totalItems} 个 Telegram 中文频道和群组，按 ${validSections.length} 个主题分类整理，支持按名称、简介、关键词和 t.me 地址搜索。`;
const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'rectg',
    url: `${SITE_URL}/`,
    inLanguage: 'zh-CN',
    description: pageDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'rectg',
    url: `${SITE_URL}/`,
    logo: `${SITE_URL}/og-image.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE_URL}/#collection`,
    url: `${SITE_URL}/`,
    name: 'rectg Telegram 中文资源索引',
    description: pageDescription,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: {
      '@type': 'Thing',
      name: 'Telegram 中文频道和群组',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${SITE_URL}/#featured-items`,
    name: 'rectg 目录摘选资源',
    numberOfItems: featuredItems.length,
    itemListElement: featuredItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absoluteUrl(itemPath(item.id)),
      name: item.title,
    })),
  },
];
---

<Layout description={pageDescription} jsonLd={homeJsonLd}>
  <div id="app">
    <!-- 侧边栏 -->
    <aside id="sidebar" aria-label="分类导航" aria-hidden="false">
      <div class="sidebar-header">
        <div class="logo">
          <div class="logo-mark" aria-hidden="true">TG</div>
          <div>
            <div class="sidebar-title">rectg</div>
          </div>
        </div>
        <button id="close-sidebar-btn" type="button" aria-label="关闭分类菜单">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"
            stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <nav id="category-nav">
        <div class="nav-section-label">主题分类</div>
        <a class="nav-item active" data-id="featured" href="/" aria-current="page">
            <span class="nav-icon">•</span>
            <span>每日推荐</span>
        </a>
        {categories.map(cat => (
          <a class="nav-item" data-id={cat.id} href={categoryPath(cat.id)}>
              <span class="nav-icon">{cat.icon}</span>
              <span>{cat.name}</span>
              <span class="nav-count">{categoryCountById.get(cat.id) || 0}</span>
          </a>
        ))}
      </nav>
      <div class="sidebar-footer">
        <a href="https://github.com/jackvale/rectg/issues/new?template=channel-submission.md" target="_blank" rel="noopener" class="submit-btn" title="提交新的频道或群组">
          提交收录
        </a>
      </div>
    </aside>

    <!-- 移动端侧边栏遮罩 -->
    <div id="sidebar-overlay" aria-hidden="true"></div>

    <!-- 主内容区 -->
    <main class="home-main">
      <header>
        <div class="header-left">
          <button id="menu-btn" type="button" aria-label="打开分类菜单" aria-expanded="false" aria-controls="sidebar">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <a class="topbar-brand" href="/" aria-label="rectg 首页">rectg</a>
        </div>

        <div class="header-search">
          <div class="search-box" role="search" aria-label="站内资源搜索">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="search-input" aria-label="搜索 Telegram 名称、简介、关键词或 t.me 地址" placeholder="搜索频道、群组或 t.me 地址" autocomplete="off" />
            <button id="clear-search-btn" class="clear-search-btn" type="button" aria-label="清空搜索">
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        <div class="header-right">
          <a class="topbar-link" href="https://github.com/jackvale/rectg" target="_blank" rel="noopener" aria-label="GitHub">
            <svg class="github-icon" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="currentColor">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.83 1.23 1.83 1.23 1.07 1.82 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.62-2.81 5.64-5.48 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z"></path>
            </svg>
          </a>
          <button id="theme-toggle" type="button" aria-label="切换到深色主题" aria-pressed="false">
            <svg class="moon-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="sun-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>
        </div>
      </header>

      <!-- 页面阅读进度 -->
      <div id="progress-container">
        <div id="progress-bar"></div>
      </div>

      <div class="mobile-category-strip" aria-label="分类">
        <a class="mobile-category-item active" href="/" data-id="featured" aria-current="page">
            <span>每日推荐</span>
          <strong>{featuredItems.length}</strong>
        </a>
        {sectionSummaries.map(section => (
          <a class="mobile-category-item" href={categoryPath(section.id)} data-id={section.id}>
            <span>{section.name}</span>
            <strong>{section.count}</strong>
          </a>
        ))}
      </div>

      <div id="content-container">
        <section class="category-section" id="active-section" data-current-id={initialSection.id}>
          <div class="section-heading">
            <div>
              <h2 class="category-title">
                <span id="active-section-title">{initialSection.fullName}</span>
                <span id="active-section-meta" class="category-title-meta">({initialSection.items.length})</span>
              </h2>
              <p id="active-section-desc" class="category-description">发现值得关注的 Telegram 频道与群组。</p>
            </div>
            <div id="result-status" class="result-status" role="status" aria-live="polite" aria-atomic="true" hidden>
              <span id="result-status-text">正在显示每日推荐</span>
              <button id="result-clear-btn" type="button">清除搜索</button>
            </div>
          </div>
          <div class="grid" id="active-grid">
            {initialSection.items.map(item => (
              <Card
                id={item.id}
                title={item.title}
                desc={item.desc}
                url={item.url}
                typeName={item.typeName}
                countStr={item.countStr}
                category={item.categoryName || item.categoryFullName || '未分类'}
              />
            ))}
          </div>
        </section>

        <section class="aeo-panel faq-only" aria-labelledby="home-faq-title">
          <div class="faq-list compact-faq" aria-labelledby="home-faq-title">
            <h2 id="home-faq-title">常见问题</h2>
            <details>
              <summary>收录条目是站点推荐吗？</summary>
              <p>不是。收录只表示该公开入口已被整理进目录，不代表对内容、立场、安全性或可靠性的背书。</p>
            </details>
            <details>
              <summary>人数和简介是实时的吗？</summary>
              <p>不是。人数和简介来自收录时可见的公开信息，Telegram 内的实际数据可能已经变化。</p>
            </details>
            <details>
              <summary>为什么有些 Telegram 链接无法打开？</summary>
              <p>频道或群组可能更名、转为私密、被删除，也可能受当前网络环境影响。如确认链接失效，欢迎通过项目入口反馈。</p>
            </details>
            <details>
              <summary>目录会记录我加入了哪些资源吗？</summary>
              <p>不会。站点只提供公开信息和外部链接，加入、退出和订阅等操作都在 Telegram 内进行。</p>
            </details>
          </div>
        </section>

        <div id="empty-state" class="empty-state" style="display: none;">
            <h3>没有找到相关资源</h3>
            <p>换一个名称、主题词或 t.me 用户名试试。</p>
            <div class="empty-actions">
              <button type="button" data-empty-action="featured">浏览目录</button>
              <button type="button" data-empty-action="clear">清空搜索</button>
            </div>
        </div>
      </div>
    </main>
  </div>

  <!-- 返回顶部 -->
  <button id="back-to-top" class="back-to-top" aria-label="返回顶部">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
  </button>
  
  <div id="toast" class="toast" role="status" aria-live="polite" aria-atomic="true">已复制链接</div>

  <footer class="site-footer">
    <div class="footer-content">
      <p><strong>站点说明</strong>：本网站只整理公开 Telegram 资源入口，不运营或代表被收录资源。访问和加入前请自行核对内容风险，并遵守所在地法律法规。</p>
      <p class="footer-copyright">© 2026 rectg · Telegram 中文资源目录</p>
    </div>
  </footer>

  <script id="directory-data" type="application/json" set:html={directoryPayload}></script>
  <script src="../scripts/main.js"></script>
</Layout>
