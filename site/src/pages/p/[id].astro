---
import Layout from '../../layouts/Layout.astro';
import {
  absoluteUrl,
  categoryPath,
  getAvatarColorClass,
  getItemPaths,
  getTelegramUsername,
  itemPath,
  SITE_URL,
} from '../../utils/data';

export async function getStaticPaths() {
  return getItemPaths();
}

const {
  item,
  categoryName,
  categoryFullName,
  typeName,
  previousItem = null,
  nextItem = null,
  relatedItems = [],
} = Astro.props;
const username = getTelegramUsername(item.url);
const avatarUrl = username ? `https://unavatar.io/telegram/${username}` : '';
const firstLetter = item.title ? item.title.substring(0, 1).toUpperCase() : '?';
const subscriberCount = item.countStr || '暂无数据';
const countLabel = typeName === '频道' ? '订阅' : typeName === '群组' ? '成员' : '人数';
const openLabel = typeName === '频道' ? '打开频道' : typeName === '群组' ? '打开群组' : '打开 Telegram';
const telegramLabel = username ? `@${username}` : item.url;
const pickText = (...values) =>
  values
    .map(value => (typeof value === 'string' ? value.trim() : ''))
    .find(Boolean) || '未分类';
const resolvedCategoryName = pickText(categoryName, categoryFullName, '未分类');
const resolvedCategoryFullName = pickText(categoryFullName, categoryName, '未分类');
const categoryId = item.categoryId || resolvedCategoryName;
const categoryHref = categoryPath(categoryId);
const colorClass = getAvatarColorClass(firstLetter);
const pageTitle = `${item.title} - rectg`;
const pageDescription = item.desc
  ? item.desc.slice(0, 120)
  : `${item.title} 的基本信息、所属分类和 Telegram 入口。`;
const detailPath = itemPath(item.id);
const detailUrl = absoluteUrl(detailPath);
const detailJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': detailUrl,
    url: detailUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': `${SITE_URL}/#website` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '首页',
        item: `${SITE_URL}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: resolvedCategoryName,
        item: absoluteUrl(categoryHref),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: item.title,
        item: detailUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Thing',
    '@id': `${detailUrl}#resource`,
    name: item.title,
    description: item.desc || pageDescription,
    url: item.url,
    sameAs: item.url,
    mainEntityOfPage: detailUrl,
    additionalProperty: [
      { '@type': 'PropertyValue', name: '类型', value: typeName },
      { '@type': 'PropertyValue', name: '分类', value: resolvedCategoryName },
      { '@type': 'PropertyValue', name: '人数', value: subscriberCount },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${detailUrl}#related`,
    name: `${resolvedCategoryName}同分类资源`,
    numberOfItems: relatedItems.length,
    itemListElement: relatedItems.map((related, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absoluteUrl(itemPath(related.id)),
      name: related.title,
    })),
  },
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath={detailPath} ogType="article" jsonLd={detailJsonLd}>
  <div id="detail-app" class="detail-page">
    <header class="detail-topbar">
      <a class="detail-brand" href="/" aria-label="rectg 首页">
        <span class="detail-brand-mark" aria-hidden="true">TG</span>
        <span>rectg</span>
      </a>

      <div class="detail-top-actions">
        <nav class="detail-topnav" aria-label="主导航">
          <a class="source-nav-link github-nav-link" href="https://github.com/jackvale/rectg" target="_blank" rel="noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.83 1.23 1.83 1.23 1.07 1.82 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.62-2.81 5.64-5.48 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z"></path>
            </svg>
          </a>
        </nav>
        <button id="theme-toggle" class="detail-theme-btn" type="button" aria-label="切换主题">
          <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </header>

    <main class="detail-container">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <a href={categoryHref}>{resolvedCategoryName}</a>
        <span aria-hidden="true">/</span>
        <span class="breadcrumb-current" aria-current="page">{item.title}</span>
      </nav>

      <div class="detail-grid">
        <article class="resource-card">
          <header class="resource-header">
            <div class="resource-avatar" aria-hidden="true">
              <div class={`resource-avatar-fallback ${colorClass}`}>{firstLetter}</div>
              {avatarUrl && (
                <img
                  src={avatarUrl}
                  alt=""
                  class="resource-avatar-image"
                  loading="eager"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
              )}
            </div>

            <div class="resource-identity">
              <p class="resource-kicker">
                <span>{typeName}</span>
                {username && <span>@{username}</span>}
              </p>
              <h1>{item.title}</h1>
            </div>
          </header>

          <section class="resource-copy" aria-labelledby="description-heading">
            <h2 id="description-heading">资源简介</h2>
            <p class:list={["resource-description", { "is-empty": !item.desc }]}>
              {item.desc || '暂无简介。你可以通过下方链接前往 Telegram 查看该资源。'}
            </p>
          </section>

          <section class="sidebar-section info-section" aria-labelledby="info-heading">
            <h2 id="info-heading">基本信息</h2>
            <dl class="resource-info">
              <div>
                <dt>{countLabel}</dt>
                <dd>{subscriberCount}</dd>
              </div>
              <div>
                <dt>类型</dt>
                <dd>{typeName}</dd>
              </div>
              <div>
                <dt>分类</dt>
                <dd><a href={categoryHref} title={resolvedCategoryFullName}>{resolvedCategoryName}</a></dd>
              </div>
              <div>
                <dt>链接</dt>
                <dd><a class="telegram-link" href={item.url} target="_blank" rel="noopener noreferrer" title={item.url}>{telegramLabel}</a></dd>
              </div>
            </dl>
          </section>

          <div class="detail-actions" aria-label="资源操作">
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="action-btn action-primary">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m22 2-7 20-4-9-9-4Z"></path>
                <path d="M22 2 11 13"></path>
              </svg>
              {openLabel}
            </a>
            <button type="button" class="action-btn copy-btn" data-copy-url={item.url}>
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              复制 Telegram 链接
            </button>
          </div>
        </article>


      </div>

      <nav class="resource-pagination" aria-label="同分类前后资源">
        {previousItem ? (
          <a href={itemPath(previousItem.id)} class="pagination-link pagination-previous">
            <span>上一个</span>
            <strong>{previousItem.title}</strong>
          </a>
        ) : (
          <span class="pagination-link is-disabled">
            <span>上一个</span>
            <strong>已经是第一条</strong>
          </span>
        )}

        {nextItem ? (
          <a href={itemPath(nextItem.id)} class="pagination-link pagination-next">
            <span>下一个</span>
            <strong>{nextItem.title}</strong>
          </a>
        ) : (
          <span class="pagination-link pagination-next is-disabled">
            <span>下一个</span>
            <strong>已经是最后一条</strong>
          </span>
        )}
      </nav>
    </main>

    <div id="copy-toast" class="copy-toast" role="status" aria-live="polite">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      <span>链接已复制</span>
    </div>
  </div>

  <script is:inline>
    const copyBtn = document.querySelector('.copy-btn');
    const copyToast = document.getElementById('copy-toast');
    const themeToggle = document.getElementById('theme-toggle');
    const themeMeta = document.getElementById('theme-color-meta');
    let copyTimer;

    function showCopyToast(message, isError = false) {
      if (!copyToast) return;

      const span = copyToast.querySelector('span');
      if (span) span.textContent = message;

      if (isError) {
        copyToast.classList.add('error');
      } else {
        copyToast.classList.remove('error');
      }

      copyToast.classList.add('show');
      clearTimeout(copyTimer);
      copyTimer = setTimeout(() => copyToast.classList.remove('show'), 2000);
    }

    async function copyText(value) {
      const clipboard = window.navigator?.clipboard;
      try {
        if (clipboard?.writeText) {
          await clipboard.writeText(value);
          return;
        }
      } catch {}

      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.top = '0';
      textarea.style.left = '0';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      textarea.setSelectionRange(0, textarea.value.length);
      try {
        const copied = document.execCommand('copy');
        if (!copied) throw new Error('copy failed');
      } finally {
        document.body.removeChild(textarea);
      }
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-copy-url') || '';
        if (!url) {
          showCopyToast('链接为空', true);
          return;
        }
        try {
          await copyText(url);
          showCopyToast('链接已复制', false);
        } catch {
          showCopyToast('复制失败', true);
        }
      });
    }

    function syncThemeMeta() {
      if (!themeMeta) return;
      themeMeta.setAttribute('content', document.body.classList.contains('dark') ? '#171615' : '#f4f1eb');
    }

    syncThemeMeta();

    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        document.body.classList.toggle('dark');
        const isDark = document.body.classList.contains('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch {}
        syncThemeMeta();
      });
    }
  </script>
</Layout>

<style>
  .detail-page {
    --detail-bg: #f4f1eb;
    --detail-surface: #fffdf9;
    --detail-soft: #faf7f2;
    --detail-text: #252522;
    --detail-muted: #615d54;
    --detail-subtle: #8a8479;
    --detail-border: #e3dbd0;
    --detail-blue: #d86a3f;
    --detail-blue-hover: #b84f2e;

    min-height: 100vh;
    background: var(--detail-bg);
    color: var(--detail-text);
  }

  :global(body.dark) .detail-page {
    --detail-bg: #171615;
    --detail-surface: #23211f;
    --detail-soft: #2b2824;
    --detail-text: #f5efe8;
    --detail-muted: #c9bfb2;
    --detail-subtle: #988e82;
    --detail-border: #3a342d;
    --detail-blue: #e08b62;
    --detail-blue-hover: #f0a27a;
  }

  .detail-topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 32px;
    border-bottom: 1px solid var(--detail-border);
    background: var(--detail-surface);
  }

  .detail-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--detail-text);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -0.01em;
  }

  .detail-brand-mark {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--detail-blue);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 800;
  }

  .detail-top-actions,
  .detail-topnav {
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .detail-top-actions {
    justify-content: flex-end;
    gap: 8px;
  }

  .detail-topnav {
    gap: 2px;
  }

  .detail-topnav a,
  .detail-topbar #theme-toggle {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--detail-muted);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .detail-topnav a {
    max-width: 180px;
    padding: 0 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .detail-topbar #theme-toggle {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    padding: 0;
    cursor: pointer;
  }

  .detail-topnav a:hover,
  .detail-topbar #theme-toggle:hover {
    background: var(--detail-soft);
    color: var(--detail-text);
  }

  .detail-container {
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 28px 24px 128px;
  }

  .breadcrumb {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--detail-subtle);
    font-size: 0.82rem;
  }

  .breadcrumb a {
    flex: 0 0 auto;
    color: var(--detail-muted);
  }

  .breadcrumb a:hover {
    color: var(--detail-blue);
  }

  .breadcrumb-current {
    min-width: 0;
    overflow: hidden;
    color: var(--detail-subtle);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 24px;
  }

  .resource-card,
  .sidebar-section,
  .pagination-link {
    border: 1px solid var(--detail-border);
    background: var(--detail-surface);
  }

  .resource-card {
    min-width: 0;
    padding: 36px;
    border-radius: 12px;
  }

  .resource-header {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .resource-avatar {
    position: relative;
    width: 76px;
    height: 76px;
    flex: 0 0 76px;
    overflow: hidden;
    border: 1px solid var(--detail-border);
    border-radius: 12px;
    background: var(--detail-soft);
  }

  .resource-avatar-fallback,
  .resource-avatar-image {
    width: 100%;
    height: 100%;
  }

  .resource-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: 750;
  }

  .resource-avatar-image {
    position: absolute;
    inset: 0;
    display: block;
    object-fit: cover;
  }

  .resource-identity {
    min-width: 0;
    padding-top: 3px;
  }

  .resource-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 7px;
    color: var(--detail-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .resource-kicker span + span::before {
    content: "·";
    margin-right: 7px;
    color: var(--detail-subtle);
  }

  .resource-identity h1 {
    margin: 0;
    color: var(--detail-text);
    font-size: clamp(1.65rem, 3vw, 2.1rem);
    font-weight: 750;
    letter-spacing: -0.025em;
    line-height: 1.28;
    overflow-wrap: anywhere;
  }

  .resource-copy {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--detail-border);
  }

  .resource-copy h2,
  .sidebar-section h2 {
    margin: 0;
    color: var(--detail-text);
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .resource-description {
    margin-top: 12px;
    color: var(--detail-muted);
    font-size: 0.98rem;
    line-height: 1.85;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .resource-description.is-empty {
    color: var(--detail-subtle);
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--detail-border);
  }

  .action-btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px;
    border: 1px solid var(--detail-border);
    border-radius: 8px;
    background: var(--detail-surface);
    color: var(--detail-text);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 650;
    transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease;
  }

  .action-btn:hover {
    border-color: #cbd0d8;
    background: var(--detail-soft);
  }

  .action-primary {
    border-color: var(--detail-blue);
    background: var(--detail-blue);
    color: #ffffff;
  }

  .action-primary:hover {
    border-color: var(--detail-blue-hover);
    background: var(--detail-blue-hover);
    color: #ffffff;
  }

  .detail-sidebar {
    position: sticky;
    top: 88px;
    min-width: 0;
  }

  .sidebar-section {
    overflow: hidden;
    border-radius: 12px;
  }

  .resource-card .info-section {
    margin-top: 28px;
  }

  .sidebar-section + .sidebar-section {
    margin-top: 16px;
  }

  .info-section > h2,
  .section-heading {
    min-height: 56px;
    display: flex;
    align-items: center;
    padding: 0 20px;
    border-bottom: 1px solid var(--detail-border);
  }

  .resource-info > div {
    min-width: 0;
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 12px;
    padding: 13px 20px;
    border-bottom: 1px solid var(--detail-border);
  }

  .resource-info > div:last-child {
    border-bottom: 0;
  }

  .resource-info dt {
    color: var(--detail-subtle);
    font-size: 0.82rem;
  }

  .resource-info dd {
    min-width: 0;
    color: var(--detail-text);
    font-size: 0.86rem;
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .resource-info a {
    color: var(--detail-text);
  }

  .resource-info a:hover,
  .resource-info .telegram-link {
    color: var(--detail-blue);
  }

  .telegram-link {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-heading {
    justify-content: space-between;
    gap: 16px;
  }

  .section-heading > a {
    flex: 0 0 auto;
    color: var(--detail-blue);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .related-item {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--detail-border);
  }

  .related-item:last-child {
    border-bottom: 0;
  }

  .related-item:hover {
    background: var(--detail-soft);
  }

  .related-text {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .related-text strong,
  .related-text small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-text strong {
