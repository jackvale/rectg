---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import {
  absoluteUrl,
  categoryPath,
  getCategoryPaths,
  itemPath,
  SITE_URL,
} from '../../utils/data';

export async function getStaticPaths() {
  return getCategoryPaths();
}

const {
  section,
  totalItems,
  channelCount,
  groupCount,
} = Astro.props;

const categoryUrl = categoryPath(section.meta.id);
const pageTitle = `${section.meta.name} Telegram 频道和群组 - rectg`;
const keywordText = section.meta.keywords ? `相关关键词：${section.meta.keywords}` : '按人数参考排序，适合查找同主题资源。';
const pageDescription = `rectg 收录 ${totalItems} 个${section.meta.name}相关 Telegram 中文频道和群组，包含人数、简介、详情页和 Telegram 链接。${section.meta.keywords ? `主题关键词：${section.meta.keywords}。` : ''}`;
const categoryJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': absoluteUrl(categoryUrl),
    url: absoluteUrl(categoryUrl),
    name: pageTitle,
    description: pageDescription,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: {
      '@type': 'Thing',
      name: `${section.meta.name} Telegram 资源`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '首页',
        item: `${SITE_URL}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: section.meta.name,
        item: absoluteUrl(categoryUrl),
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${absoluteUrl(categoryUrl)}#items`,
    name: `${section.meta.name} Telegram 资源列表`,
    numberOfItems: section.items.length,
    itemListElement: section.items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absoluteUrl(itemPath(item.id)),
      name: item.title,
    })),
  },
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath={categoryUrl} jsonLd={categoryJsonLd}>
  <div id="category-app" class="detail-page category-page">
    <header class="detail-topbar">
      <a class="detail-brand" href="/" aria-label="rectg 首页">
        <strong>rectg</strong>
        <span>Telegram 中文目录</span>
      </a>
      <div class="detail-top-actions">
        <nav class="detail-topnav" aria-label="分类页导航">
          <a href="/">目录</a>
          <a href="https://github.com/jackvale/rectg/issues/new?template=channel-submission.md" target="_blank" rel="noopener">提交收录</a>
          <a href="https://github.com/jackvale/rectg" target="_blank" rel="noopener">项目源码</a>
        </nav>
        <button id="theme-toggle" class="detail-theme-btn" type="button" aria-label="切换主题">
          <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </header>

    <main class="detail-container category-container">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <a href="/">分类</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{section.meta.name}</span>
      </nav>

      <section class="category-landing" aria-labelledby="category-title">
        <div class="category-hero-copy">
          <div class="category-icon" aria-hidden="true">{section.meta.icon || '◌'}</div>
          <div class="category-hero-text">
            <p class="category-label">主题目录</p>
            <h1 id="category-title">{section.meta.name}</h1>
            <p class="category-lead">本主题收录 {totalItems} 个公开 Telegram 频道和群组，可查看简介、人数参考和访问入口。</p>
            <p class="category-keywords">
              <span>{keywordText}</span>
            </p>
          </div>
        </div>

        <dl class="category-summary-grid" aria-label="分类统计">
          <div>
            <dt>条目</dt>
            <dd>{totalItems}</dd>
          </div>
          <div>
            <dt>频道</dt>
            <dd>{channelCount}</dd>
          </div>
          <div>
            <dt>群组</dt>
            <dd>{groupCount}</dd>
          </div>
        </dl>
      </section>

      <section id="content-container" class="category-results" aria-labelledby="category-resources-title">
        <div class="section-heading">
          <div>
            <h2 id="category-resources-title" class="category-title">
              <span>{section.meta.name}频道与群组</span>
            </h2>
            <p class="category-description">共 {section.items.length} 个条目，按收录时的人数参考排序。实际信息请以 Telegram 页面为准。</p>
          </div>
        </div>
        <div class="grid">
          {section.items.map(item => (
            <Card
              id={item.id}
              title={item.title}
              desc={item.desc}
              url={item.url}
              typeName={item.typeName}
              countStr={item.countStr}
              category={item.categoryName || section.meta.name}
            />
          ))}
        </div>
      </section>
    </main>

    <div id="toast" class="toast" role="status" aria-live="polite">已复制链接</div>
  </div>

  <script src="../../scripts/category.js"></script>
</Layout>

<style>
  .category-page {
    --page-bg: #f4f1eb;
    --page-surface: #fffdf9;
    --page-text: #252522;
    --page-muted: #615d54;
    --page-subtle: #8a8479;
    --page-line: #e3dbd0;
    --page-blue: #d86a3f;
    --page-blue-soft: #f8e5da;
    --bg-main: var(--page-bg);
    --bg-card: var(--page-surface);
    --bg-panel: #faf7f2;
    --bg-hover: #f1e9df;
    --text-main: var(--page-text);
    --text-secondary: var(--page-muted);
    --text-muted: var(--page-subtle);
    --accent: var(--page-blue);
    --accent-strong: #b84f2e;
    --accent-light: var(--page-blue-soft);
    --line: var(--page-line);
    --border: var(--page-line);
    --shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
    --shadow-hover: 0 4px 12px rgba(16, 24, 40, 0.08);
    min-height: 100vh;
    background: var(--page-bg);
    color: var(--page-text);
  }

  :global(body.dark) .category-page {
    --page-bg: #171615;
    --page-surface: #23211f;
    --page-text: #f5efe8;
    --page-muted: #c9bfb2;
    --page-subtle: #988e82;
    --page-line: #3a342d;
    --page-blue: #e08b62;
    --page-blue-soft: rgba(224, 139, 98, 0.16);
    --bg-panel: #2b2824;
    --bg-hover: #2e2924;
    --accent-strong: #f0a27a;
    --shadow: none;
    --shadow-hover: 0 4px 12px rgba(0, 0, 0, 0.18);
  }

  .detail-topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 clamp(20px, 4vw, 48px);
    border-bottom: 1px solid var(--page-line);
    background: var(--page-surface);
  }

  .detail-brand {
    min-width: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    color: var(--page-text);
  }

  .detail-brand strong {
    font-size: 1.08rem;
    font-weight: 750;
    letter-spacing: -0.01em;
  }

  .detail-brand > span {
    color: var(--page-muted);
    font-size: 0.76rem;
  }

  .detail-top-actions,
  .detail-topnav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .detail-topnav a,
  .detail-theme-btn {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--page-muted);
    font-size: 0.8rem;
    font-weight: 600;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .detail-topnav a {
    padding: 0 10px;
  }

  .category-page #theme-toggle {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    padding: 0;
    cursor: pointer;
    border-radius: 8px;
  }

  .detail-topnav a:hover,
  .detail-theme-btn:hover {
    border-color: var(--page-line);
    background: var(--page-bg);
    color: var(--page-text);
  }

  .category-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 26px clamp(20px, 4vw, 48px) 72px;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    color: var(--page-subtle);
    font-size: 0.78rem;
  }

  .breadcrumb a:hover {
    color: var(--page-blue);
  }

  .breadcrumb span[aria-current] {
    color: var(--page-muted);
  }

  .category-landing {
    overflow: hidden;
    border: 1px solid var(--page-line);
    border-radius: 12px;
    background: var(--page-surface);
    box-shadow: var(--shadow);
  }

  .category-hero-copy {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: clamp(26px, 4vw, 42px);
  }

  .category-icon {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--page-line);
    border-radius: 10px;
    background: var(--page-bg);
    font-size: 1.7rem;
  }

  .category-hero-text {
    min-width: 0;
  }

  .category-label {
    margin-bottom: 5px;
    color: var(--page-blue);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .category-hero-text h1 {
    color: var(--page-text);
    font-size: clamp(1.8rem, 3.6vw, 2.65rem);
    line-height: 1.2;
    font-weight: 720;
    letter-spacing: -0.035em;
  }

  .category-lead {
    max-width: 720px;
    margin-top: 12px;
    color: var(--page-muted);
    font-size: 0.91rem;
    line-height: 1.75;
  }

  .category-keywords {
    max-width: 100%;
    margin-top: 10px;
    color: var(--page-subtle);
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .category-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, max-content);
    gap: 0;
    padding: 15px clamp(26px, 4vw, 42px);
    border-top: 1px solid var(--page-line);
    background: color-mix(in srgb, var(--page-bg) 58%, var(--page-surface));
  }

  .category-summary-grid div {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-right: 22px;
    padding-right: 22px;
    border-right: 1px solid var(--page-line);
  }

  .category-summary-grid div:last-child {
    margin-right: 0;
    padding-right: 0;
    border-right: 0;
  }

  .category-summary-grid dt {
    color: var(--page-muted);
    font-size: 0.78rem;
  }

  .category-summary-grid dd {
    color: var(--page-text);
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .category-results {
    padding-top: 38px;
  }

  .category-results .section-heading {
    margin-bottom: 18px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--page-line);
  }

  .category-results .category-title {
    margin-bottom: 6px;
    color: var(--page-text);
    font-size: clamp(1.28rem, 2vw, 1.55rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .category-results .category-description {
    max-width: 760px;
    color: var(--page-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .category-results .grid {
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 14px;
    margin-top: 0;
  }

  .category-results :global(.card) {
    border-radius: 10px;
    background: var(--page-surface);
    box-shadow: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .category-results :global(.card)::before {
    display: none;
  }

  .category-results :global(.card):hover {
    border-color: color-mix(in srgb, var(--page-blue) 45%, var(--page-line));
    background: var(--page-surface);
    box-shadow: var(--shadow-hover);
    transform: none;
  }

  .category-results :global(.card-icon),
  .category-results :global(.card-action) {
    border-radius: 8px;
  }

  .category-results :global(.card-icon) {
    box-shadow: none;
  }

  .category-results :global(.tag),
  .category-results :global(.resource-count) {
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .detail-topbar {
      padding: 0 14px;
    }

    .detail-topnav a {
      min-height: 36px;
      padding: 0 7px;
      font-size: 0.75rem;
    }

    .detail-topnav a[href="https://github.com/jackvale/rectg"] {
      display: none;
    }

    .category-container {
      padding: 20px 14px 50px;
    }

    .breadcrumb {
      margin-bottom: 16px;
    }

    .category-hero-copy {
      gap: 16px;
      padding: 24px 20px;
    }

    .category-icon {
      width: 52px;
      height: 52px;
      flex-basis: 52px;
      font-size: 1.5rem;
    }

    .category-summary-grid {
      padding: 14px 20px;
    }

    .category-summary-grid div {
      margin-right: 14px;
      padding-right: 14px;
    }

    .category-summary-grid dt {
      font-size: 0.74rem;
    }

    .category-results {
      padding-top: 32px;
    }

    .category-results .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .detail-brand > span {
      display: none;
    }

    .detail-top-actions,
    .detail-topnav {
      gap: 2px;
    }

    .category-lead {
      font-size: 0.82rem;
    }

    .category-hero-copy {
      gap: 14px;
      padding: 22px 16px;
    }

    .category-summary-grid {
      grid-template-columns: repeat(3, 1fr);
      padding: 13px 16px;
    }

    .category-summary-grid div {
      justify-content: center;
      margin: 0;
      padding: 0 8px;
    }

    .category-summary-grid div:first-child {
      justify-content: flex-start;
      padding-left: 0;
    }

    .category-summary-grid div:last-child {
      justify-content: flex-end;
      padding-right: 0;
    }

    .category-summary-grid dt,
    .category-summary-grid dd {
      font-size: 0.73rem;
    }
  }
</style>
